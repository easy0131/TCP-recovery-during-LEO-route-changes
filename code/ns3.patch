diff --git a/scratch/main_satnet/handover.h b/scratch/main_satnet/handover.h
new file mode 100644
index 0000000..d89f49c
--- /dev/null
+++ b/scratch/main_satnet/handover.h
@@ -0,0 +1,285 @@
+// One rule for every route: geometry input plus live per-link rates and queues.
+#include "ns3/arbiter-single-forward.h"
+#include "ns3/ipv4-arbiter-routing.h"
+#include "ns3/data-rate.h"
+#include "ns3/ipv4-route.h"
+#include <cmath>
+#include <sstream>
+namespace adaptive {
+using namespace ns3;
+using Links=std::vector<std::pair<uint32_t,uint32_t>>;
+static constexpr uint64_t MEMORY_LIMIT=4*1024*1024;
+struct Entry { int32_t node,dst,next,out,in; };
+struct Gate {
+    uint32_t node=0,destination=0,newOut=0,wire=0,payload=0;
+    int64_t oldProp=0,tailProp=0,newLower=0,newProp=0,drain=0,gap=0,next=0,maxWait=0,burstTime=-1;
+    Links oldQueues,tailQueues,newQueues;
+    std::vector<Entry> keep;
+    bool retaining=false,seen=false;
+    SequenceNumber32 cutoff;
+    uint32_t queued=0,peak=0,drops=0;
+    uint64_t bytes=0,peakBytes=0,capacity=0,burst=0,maxBurst=0,admitted=0,released=0;
+};
+struct Event {
+    int64_t nominal=0,firstCheck=0,safeEnd=0,grid=0,oldRtt=0,newRtt=0;
+    uint32_t sender=0,receiver=0;
+    bool feasible=false;
+    std::vector<Entry> active,retired;
+    std::vector<Gate> gates;
+};
+static Event event;
+static std::string mode,arm;
+static bool protectOrder=true,pace=true,riskPacing=true,queueAware=false;
+static std::ofstream log,control;
+static int64_t start=-1,taper=1,congestedSince=-1,paceStart=-1;
+static bool failed=false;
+static double safeCap=0,initialCap=0,lastCap=-1;
+static Ptr<NetDevice> Device(uint32_t node,uint32_t iface) {
+    return NodeList::GetNode(node)->GetObject<Ipv4>()->GetNetDevice(iface);
+}
+static DataRate Rate(uint32_t node,uint32_t iface) {
+    DataRateValue value;NS_ABORT_MSG_IF(!Device(node,iface)->GetAttributeFailSafe("DataRate",value),"Missing link rate");
+    NS_ABORT_MSG_IF(!value.Get().GetBitRate(),"Zero link rate");return value.Get();
+}
+static Ptr<Queue<Packet>> QueueAt(uint32_t node,uint32_t iface) {
+    PointerValue value;auto dev=Device(node,iface);Ptr<Queue<Packet>> queue;
+    if(dev->GetAttributeFailSafe("TxQueue",value))queue=value.Get<Queue<Packet>>();
+    if(!queue && dev->GetAttributeFailSafe("Queue",value))queue=value.Get<Queue<Packet>>();
+    NS_ABORT_MSG_IF(!queue,"Missing device queue");return queue;
+}
+static int64_t Serialization(const Links& links,uint32_t bytes) {
+    int64_t ns=0;for(auto [n,i]:links)ns+=Rate(n,i).CalculateBytesTxTime(bytes).GetNanoSeconds();return ns;
+}
+static int64_t QueueDelay(const Links& links,bool excess=false,uint32_t wire=0) {
+    int64_t ns=0;
+    for(auto [n,i]:links) {
+        auto q=QueueAt(n,i);uint64_t bytes=q->GetNBytes();
+        if(excess) {
+            auto max=q->GetMaxSize();uint64_t budget=max.GetValue();
+            if(max.GetUnit()==PACKETS)budget*=wire;
+            bytes=bytes>budget/10?bytes-budget/10:0;
+        }
+        ns+=Rate(n,i).CalculateBytesTxTime(bytes).GetNanoSeconds();
+    }
+    return ns;
+}
+static uint64_t Bottleneck(const Links& links) {
+    uint64_t rate=UINT64_MAX;for(auto [n,i]:links)rate=std::min(rate,Rate(n,i).GetBitRate());
+    NS_ABORT_MSG_IF(rate==UINT64_MAX,"Empty route");return rate;
+}
+static int64_t Gap(int64_t a,int64_t b){return a>b?a-b+2*event.grid:0;}
+static uint64_t BufferNeed(uint64_t rate,int64_t gap,uint64_t burst) {
+    return uint64_t(std::ceil(double(rate)*gap/8e9))+burst;
+}
+static int64_t ReleaseTime(int64_t now,int64_t gap,int64_t next) {
+    const int64_t age=std::max<int64_t>(0,now-start);
+    return std::max(now+(age<taper?gap*(taper-age)/taper:0),next);
+}
+static void Row(const char* what,Gate& g,Ptr<Packet> packet,int64_t scheduled) {
+    TcpHeader tcp;packet->PeekHeader(tcp);
+    log<<Simulator::Now().GetNanoSeconds()<<','<<what<<','<<g.node<<','
+        <<tcp.GetSequenceNumber().GetValue()<<','<<tcp.GetAckNumber().GetValue()<<','
+        <<packet->GetSize()-tcp.GetSerializedSize()<<','<<scheduled<<','<<g.queued<<','<<g.bytes<<'\n';
+}
+static bool Hold(Gate* gate,Ptr<Ipv4L3Protocol> ip,Ptr<Ipv4Route> route,Ptr<Packet> packet,Ipv4Header header) {
+    auto& g=*gate;const int64_t now=Simulator::Now().GetNanoSeconds();
+    if(header.GetProtocol()!=6)return false;
+    auto dst=NodeList::GetNode(g.destination)->GetObject<Ipv4>()->GetAddress(1,0).GetLocal();
+    if(header.GetDestination()!=dst)return false;
+    TcpHeader tcp;packet->PeekHeader(tcp);uint32_t payload=packet->GetSize()-tcp.GetSerializedSize();
+    // These satellite devices serialize a two-byte PPP header in addition to IP/TCP.
+    uint32_t wire=packet->GetSize()+header.GetSerializedSize()+2;
+    g.wire=std::max(g.wire,wire);g.payload=std::max(g.payload,payload);
+    if(now!=g.burstTime){g.burstTime=now;g.burst=0;}g.burst+=wire;g.maxBurst=std::max(g.maxBurst,g.burst);
+    const auto key=g.destination==event.receiver?tcp.GetSequenceNumber():tcp.GetAckNumber();
+    if(start<0){if(!g.seen || key>g.cutoff){g.cutoff=key;g.seen=true;}return false;}
+    if(mode!="adaptive" || !protectOrder || !g.gap || (g.seen && key<=g.cutoff))return false;
+    if(now>=start+taper && !g.queued && now>=g.next)return false;
+    if(g.bytes+wire>g.capacity){++g.drops;Row("buffer_drop",g,packet,now);return true;}
+    const int64_t release=ReleaseTime(now,g.gap,g.next);
+    g.next=release+Rate(g.node,g.newOut).CalculateBytesTxTime(wire).GetNanoSeconds();
+    ++g.queued;++g.admitted;g.bytes+=wire;g.peak=std::max(g.peak,g.queued);g.peakBytes=std::max(g.peakBytes,g.bytes);
+    g.maxWait=std::max(g.maxWait,release-now);Row("enqueue",g,packet,release);
+    Simulator::Schedule(NanoSeconds(release-now),[gate,ip,route,packet,header,wire]() {
+        --gate->queued;++gate->released;gate->bytes-=wire;Row("release",*gate,packet,Simulator::Now().GetNanoSeconds());
+        ip->Lab1ResumeEgress(route,packet,header);
+    });return true;
+}
+static void Set(const std::vector<Entry>& rows) {
+    for(const auto& r:rows) {
+        auto routing=NodeList::GetNode(r.node)->GetObject<Ipv4>()->GetRoutingProtocol()->GetObject<Ipv4ArbiterRouting>();
+        NS_ABORT_MSG_IF(!routing,"Missing routing protocol");auto arbiter=DynamicCast<ArbiterSingleForward>(routing->GetArbiter());
+        NS_ABORT_MSG_IF(!arbiter,"Missing forwarding arbiter");arbiter->SetSingleForwardState(r.dst,r.next,r.out+1,r.in+1);
+    }
+}
+static void Apply() {
+    if(start<0 || mode!="adaptive")return;
+    Set(event.retired);Set(event.active);for(auto& g:event.gates)if(g.retaining)Set(g.keep);
+}
+static void Retire(Gate* g) {
+    NS_ABORT_MSG_IF(Simulator::Now().GetNanoSeconds()>event.safeEnd,"Retaining beyond valid geometry");
+    g->retaining=false;Apply();control<<Simulator::Now().GetNanoSeconds()<<",retire,"<<g->node<<','<<g->drain<<','<<event.safeEnd<<'\n';
+}
+static void SetPace(double bps) {
+    NS_ABORT_MSG_IF(bps<=0 || bps>safeCap+1,"Invalid pacing rate");
+    auto sockets=Config::LookupMatches("/NodeList/"+std::to_string(event.sender)+"/$ns3::TcpL4Protocol/SocketList/*");
+    NS_ABORT_MSG_IF(!sockets.GetN(),"Missing sender socket");
+    for(uint32_t i=0;i<sockets.GetN();++i) {
+        auto tcp=DynamicCast<TcpSocketBase>(sockets.Get(i));NS_ABORT_MSG_IF(!tcp,"Unexpected socket");
+        tcp->Lab1SetPacingCap(DataRate(uint64_t(bps)));tcp->SetPacingStatus(true);
+    }
+    if(std::abs(lastCap-bps)>1){control<<Simulator::Now().GetNanoSeconds()<<",pacing_bps,"<<event.sender<<','<<uint64_t(bps)<<",0\n";lastCap=bps;}
+}
+static void Measure() {
+    event.oldRtt=0;event.newRtt=0;
+    for(auto& g:event.gates) {
+        NS_ABORT_MSG_IF(!g.wire,"No packet sample before handover");
+        event.oldRtt+=g.oldProp+Serialization(g.oldQueues,g.wire);
+        event.newRtt+=g.newProp+Serialization(g.newQueues,g.wire);
+    }
+    auto& data=event.gates.at(0);NS_ABORT_MSG_IF(!data.payload,"No data packet sample");
+    double payloadRate=double(Bottleneck(data.newQueues))*data.payload/data.wire;
+    safeCap=std::max(payloadRate/2,payloadRate-double(data.payload)*8e9/event.newRtt);
+    initialCap=safeCap*std::min(1.0,double(event.newRtt)/event.oldRtt);taper=4*std::max(event.oldRtt,event.newRtt);
+    control<<Simulator::Now().GetNanoSeconds()<<",rtt_ns,0,"<<event.oldRtt<<','<<event.newRtt<<'\n';
+    control<<Simulator::Now().GetNanoSeconds()<<",capacity_bps,0,"<<Bottleneck(data.newQueues)<<','<<uint64_t(safeCap)<<'\n';
+    control<<Simulator::Now().GetNanoSeconds()<<",packet_bytes,0,"<<data.payload<<','<<data.wire<<'\n';
+    control<<Simulator::Now().GetNanoSeconds()<<",taper_ns,0,"<<taper<<",0\n";
+    if(arm=="auto_undo" || (arm=="auto_watch_undo" || arm=="guard_watch_undo")) {
+        // shortcut: full-rate single-flow pressure estimate, test delayed telemetry and sharing before deployment.
+        double oldPayload=double(Bottleneck(data.oldQueues))*data.payload/data.wire;
+        double excessBytes=std::max(0.0,oldPayload*event.oldRtt/8e9-payloadRate*event.newRtt/8e9);
+        double headroom=1e30;
+        for(auto [n,i]:data.newQueues)if(Rate(n,i).GetBitRate()==Bottleneck(data.newQueues)) {
+            auto q=QueueAt(n,i);auto maximum=q->GetMaxSize();
+            double maxBytes=maximum.GetValue()*(maximum.GetUnit()==PACKETS?data.wire:1.0);
+            headroom=std::min(headroom,std::max(0.0,maxBytes-q->GetNBytes())*data.payload/data.wire);
+        }
+        NS_ABORT_MSG_IF(headroom==1e30,"Missing bottleneck headroom");
+        riskPacing=excessBytes>headroom;pace=riskPacing || (arm=="auto_watch_undo" || arm=="guard_watch_undo");
+        control<<Simulator::Now().GetNanoSeconds()<<",risk_bytes,0,"<<uint64_t(excessBytes)<<','<<uint64_t(headroom)<<'\n';
+        control<<Simulator::Now().GetNanoSeconds()<<",risk_pacing,0,"<<riskPacing<<",0\n";
+    }
+}
+static int64_t OrderQueueExcess(int64_t queuedNs,int64_t rttNs) {
+    return std::max<int64_t>(0,queuedNs-rttNs/10);
+}
+static void Feedback() {
+    if(!pace)return;
+    const int64_t now=Simulator::Now().GetNanoSeconds();auto& data=event.gates.at(0);
+    int64_t excess=QueueDelay(data.newQueues,true,data.wire);
+    if(queueAware) {
+        // The order buffer is also backlog; allow 10% of the measured path RTT.
+        // shortcut: serialized backlog uses the existing single-flow egress-rate estimate.
+        int64_t queued=Rate(data.node,data.newOut).CalculateBytesTxTime(data.bytes).GetNanoSeconds();
+        int64_t hidden=OrderQueueExcess(queued,event.newRtt);
+        if(hidden>0)control<<now<<",order_queue_excess,"<<event.sender<<','<<hidden<<','<<queued<<'\n';
+        excess+=hidden;
+    }
+    if(paceStart<0) {
+        if(excess>0) {
+            if(congestedSince<0)congestedSince=now;
+            if(now-congestedSince>=event.newRtt) {
+                paceStart=now;initialCap=safeCap;control<<now<<",pacing_trigger,"<<event.sender<<','<<excess<<','<<now-congestedSince<<'\n';
+            }
+        } else congestedSince=-1;
+    }
+    if(paceStart>=0) {
+        double progress=std::min(1.0,double(now-paceStart)/(4*event.newRtt));
+        double ramp=initialCap+(safeCap-initialCap)*progress;
+        SetPace(std::min(ramp,safeCap*event.newRtt/(event.newRtt+excess)));
+    }
+    Simulator::Schedule(NanoSeconds(paceStart<0?std::max(event.grid,event.newRtt/20):event.newRtt),&Feedback);
+}
+static void PaceOnly() {Measure();paceStart=Simulator::Now().GetNanoSeconds();Feedback();}
+static bool Due(int64_t now,int64_t need){return now>=event.nominal || event.safeEnd-now<=need+event.grid;}
+static void Poll() {
+    const int64_t now=Simulator::Now().GetNanoSeconds();int64_t need=0;
+    for(auto& g:event.gates){g.drain=g.oldProp+Serialization(g.oldQueues,g.wire)+QueueDelay(g.oldQueues)+2*event.grid;need=std::max(need,g.drain);}
+    if(!Due(now,need)){Simulator::Schedule(NanoSeconds(std::min(event.grid,event.nominal+3-now)),&Poll);return;}
+    if(!event.feasible || now+need>event.safeEnd){failed=true;control<<now<<",no_safe_overlap,0,"<<need<<','<<event.safeEnd<<'\n';PaceOnly();return;}
+    Measure();
+    for(auto& g:event.gates) {
+        g.gap=Gap(g.tailProp+Serialization(g.tailQueues,g.wire)+QueueDelay(g.tailQueues),g.newLower);
+        g.capacity=BufferNeed(Rate(g.node,g.newOut).GetBitRate(),g.gap,std::max(uint64_t(g.wire),g.maxBurst));
+        if(g.capacity>MEMORY_LIMIT){failed=true;control<<now<<",memory_fallback,"<<g.node<<','<<g.capacity<<','<<MEMORY_LIMIT<<'\n';PaceOnly();return;}
+    }
+    start=now;control<<now<<",activate,0,"<<event.nominal<<','<<event.safeEnd<<'\n';
+    for(auto& g:event.gates) {
+        g.retaining=!g.keep.empty();control<<now<<",buffer_bytes,"<<g.node<<','<<g.capacity<<','<<MEMORY_LIMIT<<'\n';
+        control<<now<<",direction,"<<g.node<<','<<g.drain<<','<<g.gap<<'\n';
+        if(g.retaining)Simulator::Schedule(NanoSeconds(g.drain),&Retire,&g);
+    }
+    Apply();
+    if((event.newRtt<event.oldRtt || Bottleneck(event.gates[0].newQueues)<Bottleneck(event.gates[0].oldQueues)) && ((arm!="auto_watch_undo" && arm!="guard_watch_undo") || riskPacing))paceStart=now;
+    else control<<now<<",watch_queue,"<<event.sender<<",0,"<<event.newRtt<<'\n';
+    Feedback();
+}
+static void Defaults() {
+    const char* value=std::getenv("HYBRID_ARM");NS_ABORT_MSG_IF(!value,"Missing hybrid arm");arm=value;queueAware=arm=="queue_guard_undo";if(queueAware)arm="guard_watch_undo";
+    NS_ABORT_MSG_IF(arm!="baseline" && arm!="v5" && arm!="undo" && arm!="drain_undo" &&
+        arm!="drain_pace_undo" && arm!="full_undo" && arm!="undo_full" && arm!="auto_undo" && arm!="drain_pace" && (arm!="auto_watch_undo" && arm!="guard_watch_undo"),"Invalid hybrid arm");
+    protectOrder=arm=="v5" || arm=="full_undo" || arm=="guard_watch_undo";
+    pace=arm!="drain_undo";
+    const char* v=std::getenv("ADAPT_MODE");mode=v?v:"baseline";
+    NS_ABORT_MSG_IF(mode!="baseline" && mode!="pace" && mode!="adaptive","Invalid mode");
+    const char* path=std::getenv("ADAPT_EVENT_FILE");NS_ABORT_MSG_IF(!path,"Missing forecast input");
+    std::ifstream input(path);NS_ABORT_MSG_IF(!input,"Cannot read forecast input");std::string line,tag;bool first=true;
+    while(std::getline(input,line)) {
+        std::istringstream s(line);s>>tag;
+        if(first){NS_ABORT_MSG_IF(tag!="event","Missing event header");s>>event.nominal>>event.firstCheck>>event.safeEnd>>event.grid>>event.feasible>>event.sender>>event.receiver;first=false;}
+        else if(tag=="active" || tag=="retired"){Entry r;s>>r.node>>r.dst>>r.next>>r.out>>r.in;(tag=="active"?event.active:event.retired).push_back(r);}
+        else {
+            size_t k;s>>k;
+            if(tag=="gate") {
+                NS_ABORT_MSG_IF(k!=event.gates.size(),"Invalid gate order");Gate g;
+                s>>g.node>>g.destination>>g.oldProp>>g.tailProp>>g.newLower>>g.newProp>>g.newOut;event.gates.push_back(g);
+            } else {
+                NS_ABORT_MSG_IF(k>=event.gates.size(),"Invalid gate index");auto& g=event.gates[k];
+                if(tag=="keep"){Entry r;s>>r.node>>r.dst>>r.next>>r.out>>r.in;g.keep.push_back(r);}
+                else {uint32_t n,i;s>>n>>i;NS_ABORT_MSG_IF(tag!="oldq" && tag!="tailq" && tag!="newq","Invalid forecast tag");(tag=="oldq"?g.oldQueues:tag=="tailq"?g.tailQueues:g.newQueues).emplace_back(n,i);}
+            }
+        }
+        NS_ABORT_MSG_IF(s.fail(),"Invalid forecast row: "<<line);std::string extra;NS_ABORT_MSG_IF(s>>extra,"Extra forecast input");
+    }
+    NS_ABORT_MSG_IF(first || event.gates.size()!=2 || event.grid<=0 || event.firstCheck<=0 || event.firstCheck>event.nominal,"Invalid event");
+}
+static void Install(const std::string& runDir) {
+    NS_ABORT_MSG_IF(Gap(100,100)!=0 || Gap(101,100)!=2*event.grid+1,"Selective gap check");
+    NS_ABORT_MSG_IF(BufferNeed(100000000,10000000,1434)!=126434 || BufferNeed(200000000,10000000,1434)!=251434,"Rate-scaled byte budget check");
+    std::cout << "HYBRID_ARM name=" << (queueAware?"queue_guard_undo":arm) << " guard=" << protectOrder << " pace=" << pace << std::endl;
+    NS_ABORT_MSG_IF(OrderQueueExcess(50,1000)!=0 || OrderQueueExcess(100,1000)!=0 ||
+        OrderQueueExcess(150,1000)!=50,"Order queue delay budget check");
+    start=100;taper=1000;NS_ABORT_MSG_IF(ReleaseTime(100,1000,0)!=1100 || ReleaseTime(1100,1000,1600)!=1600,"FIFO check");start=-1;
+    log.open(runDir+"/handover.csv");control.open(runDir+"/controller.csv");NS_ABORT_MSG_IF(!log || !control,"Cannot open output");
+    log<<"time_ns,event,node,seq,ack,payload_bytes,scheduled_ns,buffer_packets,buffer_bytes\n";
+    control<<"time_ns,event,node,value_a,value_b\n";
+    for(auto& g:event.gates){auto ip=NodeList::GetNode(g.node)->GetObject<Ipv4L3Protocol>();ip->SetLab1EgressFilter(MakeBoundCallback(&Hold,&g,ip));}
+    if(arm!="baseline" && arm!="v5" && arm!="drain_pace")Simulator::Schedule(NanoSeconds(event.nominal),[]() {
+        auto sockets=Config::LookupMatches("/NodeList/"+std::to_string(event.sender)+"/$ns3::TcpL4Protocol/SocketList/*");
+        uint32_t armed=0;
+        for(uint32_t i=0;i<sockets.GetN();++i) {
+            auto tcp=DynamicCast<TcpSocketBase>(sockets.Get(i));Address peer;
+            if(tcp && tcp->GetPeerName(peer)==0 && InetSocketAddress::IsMatchingType(peer) &&
+                InetSocketAddress::ConvertFrom(peer).GetPort()==1024){tcp->ArmTimestampUndo();++armed;}
+        }
+        NS_ABORT_MSG_IF(armed!=1,"Single-flow experiment requires one connected sender");
+    });
+    if(mode=="pace")Simulator::Schedule(NanoSeconds(event.nominal+3),&PaceOnly);
+    else if(mode=="adaptive") {
+        Simulator::Schedule(NanoSeconds(event.firstCheck+3),&Poll);
+        for(int64_t tick=(event.firstCheck/100000000LL+1)*100000000LL;tick<=event.safeEnd;tick+=100000000LL)Simulator::Schedule(NanoSeconds(tick+2),&Apply);
+    }
+}
+static void Finish() {
+    for(auto& g:event.gates) {
+        NS_ABORT_MSG_IF(g.queued || g.bytes || g.admitted!=g.released || g.retaining,"Unfinished handover");
+        control<<Simulator::Now().GetNanoSeconds()<<",gate_peak,"<<g.node<<','<<g.peak<<','<<g.peakBytes<<'\n';
+        control<<Simulator::Now().GetNanoSeconds()<<",gate_totals,"<<g.node<<','<<g.admitted<<','<<g.drops<<'\n';
+        control<<Simulator::Now().GetNanoSeconds()<<",gate_max_wait,"<<g.node<<','<<g.maxWait<<",0\n";
+    }
+    NS_ABORT_MSG_IF(mode=="adaptive" && start<0 && !failed,"Missing controller decision");
+    control<<Simulator::Now().GetNanoSeconds()<<",finish,0,"<<start<<','<<failed<<'\n';
+    log.flush();control.flush();NS_ABORT_MSG_IF(!log || !control,"Controller write error");log.close();control.close();
+}
+}
diff --git a/scratch/main_satnet/lab1_packet_hops.h b/scratch/main_satnet/lab1_packet_hops.h
new file mode 100644
index 0000000..d6a1ce1
--- /dev/null
+++ b/scratch/main_satnet/lab1_packet_hops.h
@@ -0,0 +1,180 @@
+#ifndef LAB1_PACKET_HOPS_H
+#define LAB1_PACKET_HOPS_H
+// Passive diagnostic hooks only. Does not alter packet contents, queues or TCP.
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <stdexcept>
+#include "ns3/node-list.h"
+#include "ns3/node.h"
+#include "ns3/net-device.h"
+#include "ns3/packet.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/ipv4-l3-protocol.h"
+#include "ns3/traffic-control-layer.h"
+#include "ns3/queue.h"
+#include "ns3/pointer.h"
+#include "ns3/simulator.h"
+
+namespace lab1hops {
+using namespace ns3;
+struct Header { uint32_t seq=0, bytes=0, ipid=0, ttl=0; bool tcp=false, target=false; };
+static uint32_t Read32(const uint8_t* p) {
+    return (uint32_t(p[0])<<24)|(uint32_t(p[1])<<16)|(uint32_t(p[2])<<8)|p[3];
+}
+static Header Decode(const uint8_t* b, uint32_t n) {
+    Header h;
+    uint32_t o=0;
+    if (n>=2 && b[0]==0 && b[1]==0x21) o=2; // PPP IPv4 framing used by both devices
+    if (n<o+20 || (b[o]>>4)!=4) return h;
+    uint32_t ih=(b[o]&15)*4;
+    if (ih<20 || n<o+ih+20 || b[o+9]!=6) return h;
+    uint32_t total=(uint32_t(b[o+2])<<8)|b[o+3];
+    uint32_t th=(b[o+ih+12]>>4)*4;
+    if (th<20 || total<ih+th) return h;
+    // Initial experiment uses unfragmented TCP. Reject later fragments.
+    if (((uint32_t(b[o+6])<<8)|b[o+7]) & 0x1fff) return h;
+    h.tcp=true; h.seq=Read32(b+o+ih+4); h.bytes=total-ih-th;
+    h.ipid=(uint32_t(b[o+4])<<8)|b[o+5]; h.ttl=b[o+8];
+    bool flow=Read32(b+o+12)==0x0a129001 && Read32(b+o+16)==0x0a129101;
+    bool selected=h.seq==661021 || h.seq==662401 || h.seq==665161 ||
+                  h.seq==666541 || h.seq==667921;
+    h.target=flow && h.bytes>0 && selected;
+    return h;
+}
+struct QueueRef { uint32_t node, device; Ptr<NetDevice> dev; Ptr<Queue<Packet>> queue; };
+static std::vector<QueueRef> queues;
+static std::ofstream events, drops, coverage, audit;
+static uint64_t eventRows=0, dropRows=0, queueDropCallbacks=0;
+static bool enabled=false;
+static Ptr<Queue<Packet>> DeviceQueue(Ptr<NetDevice> dev) {
+    PointerValue v;
+    Ptr<Queue<Packet>> q;
+    if (dev->GetAttributeFailSafe("TxQueue",v)) q=v.Get<Queue<Packet>>();
+    if (!q && dev->GetAttributeFailSafe("Queue",v)) q=v.Get<Queue<Packet>>();
+    return q;
+}
+static void Record(std::string event, uint32_t node, uint32_t device,
+                   Queue<Packet>* q, Ptr<const Packet> p, bool drop) {
+    uint8_t b[128];
+    uint32_t n=p->CopyData(b,std::min<uint32_t>(p->GetSize(),128));
+    Header h=Decode(b,n);
+    if (!drop && !h.target) return;
+    const char* digits="0123456789abcdef";
+    std::string hex;
+    for (uint32_t i=0;i<n;++i) { hex+=digits[b[i]>>4]; hex+=digits[b[i]&15]; }
+    auto write=[&](std::ostream& out) {
+        out << Simulator::Now().GetNanoSeconds() << ',' << event << ',' << node << ','
+            << device << ',' << p->GetUid() << ',' << p->GetSize() << ','
+            << h.tcp << ',' << h.ipid << ',' << h.seq << ',' << h.bytes << ',' << h.ttl << ',';
+        if (q) out << q->GetNPackets() << ',' << q->GetNBytes() << ',' << q->GetMaxSize();
+        else out << "NA,NA,NA";
+        out << ',' << hex << '\n';
+    };
+    if (h.target) { write(events); ++eventRows; }
+    if (drop) { write(drops); ++dropRows; }
+}
+static void Ip(std::string event,uint32_t node,Ptr<const Packet> p,Ptr<Ipv4>,uint32_t iface) {
+    Record(event,node,iface,nullptr,p,false);
+}
+static void IpDrop(uint32_t node,const Ipv4Header& header,Ptr<const Packet> p,
+                   Ipv4L3Protocol::DropReason reason,Ptr<Ipv4>,uint32_t iface) {
+    auto copy=p->Copy(); copy->AddHeader(header);
+    Record("ip_drop_reason_"+std::to_string(int(reason)),node,iface,nullptr,copy,true);
+}
+static void QueueEvent(std::string event,uint32_t node,uint32_t device,
+                       Queue<Packet>* q,Ptr<const Packet> p) {
+    bool drop=event=="queue_drop_before" || event=="queue_drop_after";
+    if (drop) ++queueDropCallbacks;
+    Record(event,node,device,q,p,drop);
+}
+static void DeviceEvent(std::string event,uint32_t node,uint32_t device,Ptr<const Packet> p) {
+    bool drop=event=="MacTxDrop" || event=="PhyTxDrop" || event=="PhyRxDrop";
+    Record(event,node,device,nullptr,p,drop);
+}
+static void TcDrop(uint32_t node, Ptr<const Packet> p) {
+    Record("TcDrop", node, uint32_t(-1), nullptr, p, true);
+}
+static void Install(const std::string& dir) {
+    const char* flag=std::getenv("LAB1_HOPS");
+    if (!flag || std::string(flag)!="1") return;
+    enabled=true;
+    events.open(dir+"/hop_events.csv"); drops.open(dir+"/hop_drops.csv");
+    coverage.open(dir+"/hop_coverage.txt"); audit.open(dir+"/hop_queue_audit.csv");
+    if (!events || !drops || !coverage || !audit) throw std::runtime_error("LAB1_HOPS: cannot open logs");
+    const std::string header="time_ns,event,node,interface_or_device,uid,packet_bytes,tcp_decoded,ip_id,seq,payload_bytes,ttl,queue_packets,queue_bytes,queue_max,hex_prefix\n";
+    events<<header; drops<<header;
+    audit<<"node,device,role,same_queue,received_packets,dropped_packets,remaining_packets,queue_max\n";
+    coverage<<"version=1\ntarget_sequences=661021 662401 665161 666541 667921\n"
+            <<"flow_ipv4=10.18.144.1->10.18.145.1\n"
+            <<"all_drop_callbacks_logged; multiple_hooks_can_report_same_loss\n"
+            <<"IP events use IPv4 interface index; other events use device index\n";
+    uint32_t ips=0, devices=0, missing=0;
+    for (auto it=NodeList::Begin();it!=NodeList::End();++it) {
+        auto node=*it; auto id=node->GetId(); auto ip=node->GetObject<Ipv4L3Protocol>();
+        auto tc=node->GetObject<TrafficControlLayer>();
+        bool tcOk=tc && tc->TraceConnectWithoutContext(
+            "TcDrop",MakeBoundCallback(&TcDrop,id));
+        if (!tcOk) {
+            ++missing;
+            coverage<<"missing_tc_hook="<<id<<'\n';
+        }
+        if (ip) {
+            bool tx=ip->TraceConnectWithoutContext("Tx",MakeBoundCallback(&Ip,std::string("ip_tx"),id));
+            bool rx=ip->TraceConnectWithoutContext("Rx",MakeBoundCallback(&Ip,std::string("ip_rx"),id));
+            bool dr=ip->TraceConnectWithoutContext("Drop",MakeBoundCallback(&IpDrop,id));
+            if (tx && rx && dr) ++ips; else { ++missing; coverage<<"missing_ip="<<id<<'\n'; }
+        }
+        for (uint32_t j=0;j<node->GetNDevices();++j) {
+            auto dev=node->GetDevice(j);
+            if (dev->GetInstanceTypeId().GetName()=="ns3::LoopbackNetDevice") continue;
+            ++devices;
+            auto q=DeviceQueue(dev);
+            if (!q) { ++missing; coverage<<"missing_queue="<<id<<'/'<<j<<'\n'; }
+            else {
+                queues.push_back({id,j,dev,q});
+                const char* names[]={"Enqueue","Dequeue","DropBeforeEnqueue","DropAfterDequeue"};
+                const char* labels[]={"queue_enqueue","queue_dequeue","queue_drop_before","queue_drop_after"};
+                for (uint32_t k=0;k<4;++k) {
+                    if (!q->TraceConnectWithoutContext(names[k],MakeBoundCallback(&QueueEvent,std::string(labels[k]),id,j,PeekPointer(q)))) {
+                        ++missing; coverage<<"missing_queue_hook="<<id<<'/'<<j<<':'<<names[k]<<'\n';
+                    }
+                }
+            }
+            for (const char* name : {"MacTx","MacTxDrop","MacRx","PhyTxBegin","PhyTxEnd","PhyTxDrop","PhyRxEnd","PhyRxDrop"}) {
+                if (!dev->TraceConnectWithoutContext(name,MakeBoundCallback(&DeviceEvent,std::string(name),id,j))) {
+                    ++missing; coverage<<"missing_device_hook="<<id<<'/'<<j<<':'<<name<<'\n';
+                }
+            }
+        }
+    }
+    coverage<<"connected_ip_nodes="<<ips<<" connected_devices="<<devices<<" connected_queues="<<queues.size()<<" missing_required="<<missing<<std::endl;
+    if (missing || ips!=NodeList::GetNNodes() || queues.empty()) throw std::runtime_error("LAB1_HOPS: incomplete trace coverage");
+}
+static void Finish() {
+    if (!enabled) return;
+    uint64_t received=0, dropped=0; uint32_t changed=0;
+    auto row=[&](const QueueRef& r,Ptr<Queue<Packet>> q,const char* role,bool same) {
+        audit<<r.node<<','<<r.device<<','<<role<<','<<same<<','<<q->GetTotalReceivedPackets()<<','
+             <<q->GetTotalDroppedPackets()<<','<<q->GetNPackets()<<','<<q->GetMaxSize()<<'\n';
+    };
+    for (const auto& r:queues) {
+        auto current=DeviceQueue(r.dev); bool same=current==r.queue;
+        if (!same) ++changed;
+        received+=r.queue->GetTotalReceivedPackets(); dropped+=r.queue->GetTotalDroppedPackets();
+        if (!same || r.queue->GetTotalReceivedPackets() || r.queue->GetTotalDroppedPackets()) row(r,r.queue,"attached",same);
+        if (!same && current) row(r,current,"current",false);
+    }
+    coverage<<"target_event_rows="<<eventRows<<" drop_hook_rows="<<dropRows<<'\n'
+            <<"attached_queue_received="<<received<<" attached_queue_dropped="<<dropped
+            <<" queue_drop_callbacks="<<queueDropCallbacks<<" changed_queue_objects="<<changed<<'\n'
+            <<"completed=1\n";
+    events.flush(); drops.flush(); audit.flush(); coverage.flush();
+    if (!events || !drops || !audit || !coverage) throw std::runtime_error("LAB1_HOPS: output write failure");
+    events.close(); drops.close(); audit.close(); coverage.close(); queues.clear();
+}
+} // namespace lab1hops
+#endif
