+static void Record(const std::string& event, uint32_t node, uint32_t iface,
+                   Ptr<const Packet> p, const std::string& detail) {
+    uint8_t bytes[128];
+    uint32_t n = p->CopyData(bytes, std::min<uint32_t>(p->GetSize(), sizeof(bytes)));
+    static const char hex[] = "0123456789abcdef";
+    std::string prefix;
+    prefix.reserve(2 * n);
+    for (uint32_t i = 0; i < n; ++i) {
+        prefix += hex[bytes[i] >> 4];
+        prefix += hex[bytes[i] & 15];
+    }
+    packets << Simulator::Now().GetNanoSeconds() << ',' << event << ','
+            << node << ',' << iface << ',' << p->GetUid() << ','
+            << p->GetSize() << ',' << detail << ',' << prefix << '\n';
+    ++packetRows;
+}
+static void IpPacket(std::string event, uint32_t node, Ptr<const Packet> p,
+                     Ptr<Ipv4> ipv4, uint32_t iface) {
