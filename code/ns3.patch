+void
+TcpSocketBase::ArmTimestampUndo()
+{
+    if (!m_tcb->m_srtt.Get().IsStrictlyPositive()) return;
+    m_labUndoUntil = Simulator::Now() + 2 * m_tcb->m_srtt.Get();
+    m_labUndoUsed = false;
+    std::cout << "HYBRID_UNDO_WINDOW until_ns=" << m_labUndoUntil.GetNanoSeconds() << std::endl;
+    std::cout << "LAB1_UNDO_ARM time_ns=" << Simulator::Now().GetNanoSeconds() << std::endl;
+}
+
+void
+TcpSocketBase::BeginTimestampUndo()
+{
+    if (m_labUndoUntil.IsZero()) return;
+    if (m_labUndoUsed || Simulator::Now() >= m_labUndoUntil || !m_timestampEnabled) {
+        std::cout << "HYBRID_UNDO_SKIP time_ns=" << Simulator::Now().GetNanoSeconds()
+                  << " reason=" << (m_labUndoUsed?"used":(!m_timestampEnabled?"no_timestamp":"expired")) << std::endl;
+        return;
+    }
+    auto cubic = DynamicCast<TcpCubic>(m_congestionControl);
+    if (!cubic) return;
+    m_labUndoUsed = true;
+    m_labUndoActive = true;
+    m_labUndoBlocked = false;
+    m_labUndoCwnd = m_tcb->m_cWnd.Get();
+    m_labUndoSsThresh = m_tcb->m_ssThresh.Get();
+    m_labUndoRestoreCubic = cubic->SaveUndoStateForExperiment();
+    m_labUndoTx.clear();
+    std::cout << "LAB1_UNDO_BEGIN time_ns=" << Simulator::Now().GetNanoSeconds()
+              << " saved_cwnd=" << m_labUndoCwnd << std::endl;
+}
+
+void
+TcpSocketBase::ObserveTimestampUndoAck(const TcpHeader& header)
+{
+    if (!m_labUndoActive) return;
+    if (header.GetFlags() & TcpHeader::ECE) m_labUndoBlocked = true;
+    if (header.GetAckNumber() <= m_txBuffer->HeadSequence()) return;
+    bool hasTs = header.HasOption(TcpOption::TS);
+    uint32_t echo = hasTs ? DynamicCast<const TcpOptionTS>(header.GetOption(TcpOption::TS))->GetEcho() : 0;
+    for (auto& tx : m_labUndoTx) {
+        if (!tx.checked && header.GetAckNumber() >= tx.end) {
+            tx.checked = true;
+            tx.originalEvidence = hasTs && int32_t(echo - tx.timestamp) < 0;
+            std::cout << "HYBRID_UNDO_EVIDENCE time_ns=" << Simulator::Now().GetNanoSeconds()
+                      << " end=" << tx.end.GetValue() << " retx_ts=" << tx.timestamp
+                      << " ack=" << header.GetAckNumber().GetValue() << " echo=" << echo
+                      << " proven=" << tx.originalEvidence << std::endl;
+        }
+    }
+}
+
+void
+TcpSocketBase::FinishTimestampUndo()
+{
+    if (!m_labUndoActive) return;
+    m_labUndoActive = false;
+    uint32_t proven = 0;
+    for (const auto& tx : m_labUndoTx) if (tx.checked && tx.originalEvidence) ++proven;
+    if (m_labUndoBlocked || m_labUndoTx.empty() || proven != m_labUndoTx.size()) {
+        std::cout << "LAB1_UNDO_REJECT time_ns=" << Simulator::Now().GetNanoSeconds()
+                  << " proven=" << proven << " retransmissions=" << m_labUndoTx.size() << std::endl;
+        m_labUndoRestoreCubic = nullptr;
+        return;
+    }
+    uint32_t flight = BytesInFlight();
+    uint32_t before = m_tcb->m_cWnd.Get();
+    uint32_t safe = std::max(before, std::min(m_labUndoCwnd, flight + 10 * m_tcb->m_segmentSize));
+    m_labUndoRestoreCubic();
+    m_labUndoRestoreCubic = nullptr;
+    const bool full=std::getenv("HYBRID_FULL_UNDO") && std::string(std::getenv("HYBRID_FULL_UNDO"))=="1";
+    if(full) {
+        m_tcb->m_cWnd = safe;m_tcb->m_cWndInfl = safe;
+        m_tcb->m_ssThresh = std::max(m_labUndoCwnd, m_labUndoSsThresh);
+    }
+    std::cout << "HYBRID_UNDO_COMPONENT time_ns=" << Simulator::Now().GetNanoSeconds()
+              << " full=" << full << " cwnd_before=" << before << " cwnd_after=" << m_tcb->m_cWnd.Get()
+              << " cap_bps=" << m_tcb->m_maxPacingRate.GetBitRate() << std::endl;
+    std::cout << "LAB1_UNDO_APPLY time_ns=" << Simulator::Now().GetNanoSeconds()
+              << " proven=" << proven << " retransmissions=" << m_labUndoTx.size()
+              << " cwnd_before=" << before << " cwnd_after=" << m_tcb->m_cWnd.Get()
+              << " target=" << m_labUndoCwnd << " flight=" << flight << std::endl;
+}
