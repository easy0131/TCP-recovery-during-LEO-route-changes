+    (void)ipv4;
+    Ptr<Packet> copy = p->Copy();
+    copy->AddHeader(header);
+    ++dropRows;
+    Record("ip_drop", node, iface, copy, "reason=" + std::to_string(int(reason)));
+}
+static void MacDrop(uint32_t node, uint32_t device, Ptr<const Packet> p) {
