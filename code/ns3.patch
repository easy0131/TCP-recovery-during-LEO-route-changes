+static void AttachSocket() {
+    // Single flow starts at t=0. Its sender socket exists by t=0.001 s for this t=0 single-flow experiment.
+    auto matches = Config::LookupMatches("/NodeList/1584/$ns3::TcpL4Protocol/SocketList/*");
+    coverage << "sender_socket_matches=" << matches.GetN() << std::endl;
+    uint32_t count = 0, rttCount = 0, retxCount = 0;
+    for (uint32_t i = 0; i < matches.GetN(); ++i) {
+        if (matches.Get(i)->TraceConnectWithoutContext(
+                "CongState", MakeBoundCallback(&Congestion, uint32_t(1584), i))) ++count;
+        if (matches.Get(i)->TraceConnectWithoutContext(
+                "LastRTT", MakeBoundCallback(&RttSample, uint32_t(1584), i))) ++rttCount;
+        if (matches.Get(i)->TraceConnectWithoutContext(
+                "Retransmission", MakeBoundCallback(&Retransmission, uint32_t(1584), i))) ++retxCount;
+    }
+    coverage << "sender_congestion_state_connections=" << count << std::endl;
+    coverage << "last_rtt_connections=" << rttCount << std::endl;
+    if (rttCount == 0) throw std::runtime_error("No LastRTT connection");
+    coverage << "retransmission_connections=" << retxCount << std::endl;
+    if (retxCount == 0) throw std::runtime_error("No Retransmission connection");
+    if (count == 0) throw std::runtime_error("LAB1_DIAG: no sender-node CongState connection");
+}
