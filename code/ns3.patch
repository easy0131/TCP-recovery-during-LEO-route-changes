+}
+static void Congestion(uint32_t node, uint32_t socketIndex, TcpSocketState::TcpCongState_t oldState,
+                       TcpSocketState::TcpCongState_t newState) {
+    states << Simulator::Now().GetNanoSeconds() << ',' << node << ',' << socketIndex << ','
+           << int(oldState) << ',' << int(newState) << '\n';
+}
+static void RttSample(uint32_t node, uint32_t socketIndex, Time, Time value) {
+    rtts << Simulator::Now().GetNanoSeconds() << ',' << node << ',' << socketIndex
